# development@v3
DB_VERSION=18.3
DB_IMAGE=postgres

DB_NAME=postgres

DB_ADMIN=postgres
DB_ADMIN_PASS=111
DB_HOST=localhost
DB_PORT_FROM_MASTER=5432
DB_PORT_TO_MASTER=5432

DB_PORT_FROM_SLAVE=5433
DB_PORT_TO_SLAVE=5432

DB_VOLUME_MASTER=coursework:/var/lib/master/postgresql
DB_VOLUME_SLAVE=coursework:/var/lib/slave/postgresql