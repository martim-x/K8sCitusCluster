DB_IMAGE=postgres
DB_VERSION=18.3
DB_NAME=postgres

DB_ADMIN=postgres
DB_ADMIN_PASS=111

DB_PORT_FROM_MASTER=5432
DB_PORT_FROM_SLAVE_1=5433
DB_PORT_FROM_SLAVE_2=5434

DB_PORT_TO_MASTER=5432
DB_PORT_TO_SLAVE_1=5432
DB_PORT_TO_SLAVE_2=5432

DB_VOLUME_MASTER=postgres_master_data:/var/lib/postgresql
DB_VOLUME_SLAVE_1=postgres_slave_1_data:/var/lib/postgresql
DB_VOLUME_SLAVE_2=postgres_slave_2_data:/var/lib/postgresql

REPL_USER=repl_user
REPL_PASSWORD=111

REPL_DB_NAME=postgres
REPL_HOST=postgres-master
REPL_PORT=5432